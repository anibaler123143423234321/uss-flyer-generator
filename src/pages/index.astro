            if (sidebarInicioPhotoThumb) sidebarInicioPhotoThumb.src = res;
            if (sliderInicioZoom) sliderInicioZoom.value = "100";
            if (sliderInicioPosY) sliderInicioPosY.value = "0";
            if (sliderInicioPosX) sliderInicioPosX.value = "0";
            updateInicioPhotoTransform();
          }
        };
        reader.readAsDataURL(file);
