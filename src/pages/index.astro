---
// src/pages/index.astro
import Sidebar from "../components/Sidebar.astro";
import FlyerCard from "../components/FlyerCard.astro";
import FlyerParticipacionCard from "../components/FlyerParticipacionCard.astro";
import FlyerInicioCursoCard from "../components/FlyerInicioCursoCard.astro";
import "../styles/global.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Generador Oficial de Flyer USS - Centro de Informática</title>
    <meta
      name="description"
      content="Herramienta oficial del Centro de Informática USS para la generación y registro institucional de flyers para docentes."
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href={`${base}/logo-uss.png`} />

    <!-- Fuentes Google: Inter (UI), Montserrat y Caveat (Flyer) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Inter:wght@300;400;500;600;700;800&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,700;1,800&display=swap"
      rel="stylesheet"
      crossorigin="anonymous"
    />

    <!-- Inicialización del tema sin parpadeo (Blanco por defecto) -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem("uss_theme");
        const theme = saved === "dark" ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <div class="app-root">
      <!-- PANEL LATERAL DE EDICIÓN -->
      <Sidebar />

      <!-- ÁREA DE PREVISUALIZACIÓN CENTRAL (AUTO-AJUSTE SIN SCROLL) -->
      <main class="preview-viewport" id="previewViewport">
        <!-- Barra Flotante de Zoom Compacta -->
        <div class="compact-float-bar">
          <span id="zoomPercentText" style="font-weight: 600;">100%</span>
          <button
            class="btn-zoom-mini"
            id="btnZoomOut"
            type="button"
            title="Reducir">−</button
          >
          <button
            class="btn-zoom-mini"
            id="btnZoomIn"
            type="button"
            title="Aumentar">+</button
          >
          <button
            class="btn-zoom-mini"
            id="btnZoomFit"
            type="button"
            title="Auto-ajustar a pantalla"
            style="font-size: 10px; color: var(--uss-cyan-text);"
            >Auto-ajustar</button
          >
          <span class="float-bar-divider"></span>
          <!-- Botón de Modo Oscuro en Barra Flotante -->
          <button
            class="btn-zoom-mini btn-theme-float"
            id="btnThemeToggleFloat"
            type="button"
            title="Cambiar Modo Oscuro / Claro"
            aria-label="Alternar tema"
          >
            <svg class="icon-moon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg class="icon-sun" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
          </button>
        </div>

        <!-- Botón visible en pantallas móviles para regresar al formulario -->
        <button class="btn-mobile-jump-edit" id="btnMobileJumpToEditor" type="button">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="18 15 12 9 6 15"/>
          </svg>
          <span>↑ Subir a Editar Formulario</span>
        </button>

        <!-- Contenedor exterior para calibración responsiva en móviles -->
        <div class="banner-wrapper-outer" id="bannerWrapperOuter">
          <!-- Contenedor con Escala Dinámica -->
          <div class="banner-wrapper" id="bannerWrapper">
            <!-- 1. Flyer de Participación en Clases (Por Defecto) -->
            <FlyerParticipacionCard />

            <!-- 2. Flyer de Bienvenida Docente (En Pestaña 2) -->
            <div id="flyerDocenteContainer" style="display: none;">
              <FlyerCard />
            </div>

            <!-- 3. Post Inicio de Clases con Estudiantes (En Pestaña 3 - FB / IG) -->
            <div id="flyerInicioCursoContainer" style="display: none;">
              <FlyerInicioCursoCard />
            </div>
          </div>
        </div>
      </main>
    </div>

    <!-- Overlay de progreso al exportar -->
    <div class="export-overlay" id="exportOverlay">
      <div class="export-spinner"></div>
      <p id="exportStatusText">Renderizando flyer en Alta Definición (HD)...</p>
    </div>

    <!-- Contenedor de Toasts de Notificación -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Botón Flotante Rápido para Móviles (Floating Action Pill) -->
    <div class="mobile-float-pill" id="mobileFloatPill">
      <button type="button" class="btn-float-pill" id="btnFloatPill" aria-label="Navegar entre formulario y flyer">
        <svg id="pillIconEye" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
        <svg id="pillIconEdit" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
          <path d="M12 20h9"/>
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
        </svg>
        <span id="pillText">Ver Flyer</span>
      </button>
    </div>

    <!-- Lógica Interactiva del Cliente (Astro ESM) -->
    <script>
      import * as htmlToImage from "html-to-image";
      import html2canvas from "html2canvas";
      import { registrarGeneracionFlyer } from "../lib/supabase.js";

      // ==========================================
      // 0. AUTO-RECUPERACIÓN GLOBAL DE ASSETS 404 (/flyers vs /)
      // ==========================================
      window.addEventListener(
        "error",
        (e: Event) => {
          const target = e.target as HTMLElement | null;
          if (target && target.tagName === "IMG") {
            const img = target as HTMLImageElement;
            if (!img.dataset.autoFallback) {
              img.dataset.autoFallback = "1";
              if (img.src.includes("/flyers/")) {
                img.src = img.src.replace("/flyers/", "/");
              } else {
                try {
                  const url = new URL(img.src);
                  img.src = "/flyers" + url.pathname;
                } catch {
                  img.src = "/flyers/" + img.src;
                }
              }
            }
          }
        },
        true,
      );

      // ==========================================
      // 1. ESTADO DE PESTAÑAS (TABS)
      // ==========================================
      let currentTab = "participacion"; // Por defecto: Nuevo Flyer de Participación

      // Elementos de Navegación de Pestañas
      const tabBtnParticipacion = document.getElementById(
        "tabBtnParticipacion",
      );
      const tabBtnBienvenida = document.getElementById("tabBtnBienvenida");
      const tabBtnInicioCurso = document.getElementById("tabBtnInicioCurso");
      const tabPaneParticipacion = document.getElementById(
        "tabPaneParticipacion",
      );
      const tabPaneBienvenida = document.getElementById("tabPaneBienvenida");
      const tabPaneInicioCurso = document.getElementById("tabPaneInicioCurso");
      const flyerParticipacionCard = document.getElementById(
        "flyerParticipacionCard",
      );
      const flyerDocenteContainer = document.getElementById(
        "flyerDocenteContainer",
      );
      const flyerInicioCursoContainer = document.getElementById(
        "flyerInicioCursoContainer",
      );
      const flyerInicioCursoCard = document.getElementById(
        "flyerInicioCursoCard",
      );
      const btnDownloadLabel = document.getElementById("btnDownloadLabel");

      // Elementos del Flyer de Participación
      const inputPartCurso = document.getElementById(
        "inputPartCurso",
      ) as HTMLInputElement | null;
      const inputPartPead = document.getElementById(
        "inputPartPead",
      ) as HTMLInputElement | null;
      const viewPartCursoPead = document.getElementById("viewPartCursoPead");

      // Variables de Estado de Bienvenida Docente
      const defaultPhotoUrl =
        "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=600";
      let currentPhotoSrc = defaultPhotoUrl;
      let currentZoom = 100;
      let currentPosY = 0;
      let currentScale = 1.0;

      // Variables de Estado de Inicio de Curso (Post FB / IG / Story)
      const base = (import.meta.env.BASE_URL || "").replace(/\/$/, "");
      let currentInicioFormat: "1:1" | "4:5" | "9:16" = "1:1";
      const defaultInicioPhotoUrl = `${base}/laptop-zoom.jpg`;
      let currentInicioPhotoSrc = defaultInicioPhotoUrl;
      let currentInicioZoom = 100;
      let currentInicioPosY = 0;
      let currentInicioPosX = 0;

      // Inputs Tab 3: Inicio de Curso
      const sidebarInicioPhotoThumb = document.getElementById(
        "sidebarInicioPhotoThumb",
      ) as HTMLImageElement | null;
      const inicioPhotoInput = document.getElementById(
        "inicioPhotoInput",
      ) as HTMLInputElement | null;
      const btnTriggerUploadInicio = document.getElementById(
        "btnTriggerUploadInicio",
      );
      const btnResetInicioPhoto = document.getElementById(
        "btnResetInicioPhoto",
      );
      const sliderInicioZoom = document.getElementById(
        "sliderInicioZoom",
      ) as HTMLInputElement | null;
      const sliderInicioPosY = document.getElementById(
        "sliderInicioPosY",
      ) as HTMLInputElement | null;
      const sliderInicioPosX = document.getElementById(
        "sliderInicioPosX",
      ) as HTMLInputElement | null;
      const zoomInicioVal = document.getElementById("zoomInicioVal");
      const posInicioYVal = document.getElementById("posInicioYVal");
      const posInicioXVal = document.getElementById("posInicioXVal");
      const inputInicioDocenteNombre = document.getElementById(
        "inputInicioDocenteNombre",
      ) as HTMLInputElement | null;
      const checkShowInicioTeacher = document.getElementById(
        "checkShowInicioTeacher",
      ) as HTMLInputElement | null;

      const btnFormatSquare = document.getElementById("btnFormatSquare");
      const btnFormatPortrait = document.getElementById("btnFormatPortrait");
      const btnFormatStory = document.getElementById("btnFormatStory");

      const inputInicioCurso = document.getElementById(
        "inputInicioCurso",
      ) as HTMLInputElement | null;
      const inputInicioPead = document.getElementById(
        "inputInicioPead",
      ) as HTMLInputElement | null;
      const inputInicioCiclo = document.getElementById(
        "inputInicioCiclo",
      ) as HTMLInputElement | null;
      const inputInicioModalidad = document.getElementById(
        "inputInicioModalidad",
      ) as HTMLSelectElement | null;
      const inputInicioTurno = document.getElementById(
        "inputInicioTurno",
      ) as HTMLInputElement | null;
      const inputInicioFecha = document.getElementById(
        "inputInicioFecha",
      ) as HTMLInputElement | null;
      const inputInicioMensaje = document.getElementById(
        "inputInicioMensaje",
      ) as HTMLTextAreaElement | null;

      // Nodos visuales Tab 3
      const viewInicioPhotoImg = document.getElementById(
        "viewInicioPhotoImg",
      ) as HTMLImageElement | null;
      const viewInicioBadgeSesion = document.getElementById(
        "viewInicioBadgeSesion",
      );
      const viewInicioCiclo = document.getElementById("viewInicioCiclo");
      const viewInicioTitular = document.getElementById("viewInicioTitular");
      const viewInicioCursoNombre = document.getElementById(
        "viewInicioCursoNombre",
      );
      const viewInicioChipPead = document.getElementById("viewInicioChipPead");
      const viewInicioChipModalidad = document.getElementById(
        "viewInicioChipModalidad",
      );
      const viewInicioChipTurno = document.getElementById(
        "viewInicioChipTurno",
      );
      const viewInicioPlataformaTag = document.getElementById(
        "viewInicioPlataformaTag",
      );
      const viewInicioTeacherTag = document.getElementById(
        "viewInicioTeacherTag",
      );
      const viewInicioDocenteNombre = document.getElementById(
        "viewInicioDocenteNombre",
      );
      const viewInicioDocenteTagNombre = document.getElementById(
        "viewInicioDocenteTagNombre",
      );
      const viewInicioFechaText = document.getElementById(
        "viewInicioFechaText",
      );
      const viewInicioComunidadText = document.getElementById(
        "viewInicioComunidadText",
      );
      const viewInicioMensaje = document.getElementById("viewInicioMensaje");

      // Inputs del Formulario Bienvenida Docente
      const inputDocenteNombre = document.getElementById(
        "inputDocenteNombre",
      ) as HTMLInputElement | null;
      const inputPhotoUrl = document.getElementById(
        "inputPhotoUrl",
      ) as HTMLInputElement | null;
      const inputCurso = document.getElementById(
        "inputCurso",
      ) as HTMLInputElement | null;
      const inputTipoCurso = document.getElementById(
        "inputTipoCurso",
      ) as HTMLSelectElement | null;
      const inputPead = document.getElementById(
        "inputPead",
      ) as HTMLInputElement | null;
      const inputSemanas = document.getElementById(
        "inputSemanas",
      ) as HTMLInputElement | null;
      const inputCiclo = document.getElementById(
        "inputCiclo",
      ) as HTMLInputElement | null;
      const checkShowTeacherScript = document.getElementById(
        "checkShowTeacherScript",
      ) as HTMLInputElement | null;

      const inputModalidad = document.getElementById(
        "inputModalidad",
      ) as HTMLInputElement | null;
      const inputGrupo = document.getElementById(
        "inputGrupo",
      ) as HTMLInputElement | null;
      const inputTurno = document.getElementById(
        "inputTurno",
      ) as HTMLInputElement | null;
      const inputDias = document.getElementById(
        "inputDias",
      ) as HTMLInputElement | null;
      const inputHoras = document.getElementById(
        "inputHoras",
      ) as HTMLInputElement | null;
      const inputFechaInicio = document.getElementById(
        "inputFechaInicio",
      ) as HTMLInputElement | null;

      const sliderZoom = document.getElementById(
        "sliderZoom",
      ) as HTMLInputElement | null;
      const sliderPosY = document.getElementById(
        "sliderPosY",
      ) as HTMLInputElement | null;
      const zoomVal = document.getElementById("zoomVal");
      const posVal = document.getElementById("posVal");

      // Nodos del Flyer de Bienvenida
      const viewCursoTitulo = document.getElementById("viewCursoTitulo");
      const viewPeadBadge = document.getElementById("viewPeadBadge");
      const viewTipoCurso = document.getElementById("viewTipoCurso");
      const viewSemanasText = document.getElementById("viewSemanasText");
      const viewDocenteNombre = document.getElementById("viewDocenteNombre");
      const viewTeacherAnnotation = document.getElementById(
        "viewTeacherAnnotation",
      );
      const viewTeacherImg = document.getElementById(
        "viewTeacherImg",
      ) as HTMLImageElement | null;
      const sidebarPhotoThumb = document.getElementById(
        "sidebarPhotoThumb",
      ) as HTMLImageElement | null;

      const viewTableCurso = document.getElementById("viewTableCurso");
      const viewTableModalidad = document.getElementById("viewTableModalidad");
      const viewTableGrupo = document.getElementById("viewTableGrupo");
      const viewTableTurno = document.getElementById("viewTableTurno");
      const viewTableDias = document.getElementById("viewTableDias");
      const viewTableHoras = document.getElementById("viewTableHoras");
      const viewFechaInicio = document.getElementById("viewFechaInicio");

      const bannerWrapper = document.getElementById("bannerWrapper");
      const zoomPercentText = document.getElementById("zoomPercentText");
      const flyerCard = document.getElementById("flyerCard");
      const previewViewport = document.getElementById("previewViewport");

      // ==========================================
      // 2. CAMBIO DE PESTAÑAS (SWITCH TABS)
      // ==========================================
      function switchTab(tab: string) {
        currentTab = tab;

        if (tab === "participacion") {
          tabBtnParticipacion?.classList.add("active");
          tabBtnBienvenida?.classList.remove("active");
          tabBtnInicioCurso?.classList.remove("active");
          if (tabPaneParticipacion) tabPaneParticipacion.style.display = "flex";
          if (tabPaneBienvenida) tabPaneBienvenida.style.display = "none";
          if (tabPaneInicioCurso) tabPaneInicioCurso.style.display = "none";
          if (flyerParticipacionCard)
            flyerParticipacionCard.style.display = "block";
          if (flyerDocenteContainer)
            flyerDocenteContainer.style.display = "none";
          if (flyerInicioCursoContainer)
            flyerInicioCursoContainer.style.display = "none";
          if (btnDownloadLabel)
            btnDownloadLabel.textContent = "Descargar Flyer Participación (HD)";
        } else if (tab === "bienvenida") {
          tabBtnParticipacion?.classList.remove("active");
          tabBtnBienvenida?.classList.add("active");
          tabBtnInicioCurso?.classList.remove("active");
          if (tabPaneParticipacion) tabPaneParticipacion.style.display = "none";
          if (tabPaneBienvenida) tabPaneBienvenida.style.display = "flex";
          if (tabPaneInicioCurso) tabPaneInicioCurso.style.display = "none";
          if (flyerParticipacionCard)
            flyerParticipacionCard.style.display = "none";
          if (flyerDocenteContainer)
            flyerDocenteContainer.style.display = "block";
          if (flyerInicioCursoContainer)
            flyerInicioCursoContainer.style.display = "none";
          if (btnDownloadLabel)
            btnDownloadLabel.textContent = "Descargar Flyer Docente (HD)";
        } else if (tab === "inicio-curso") {
          tabBtnParticipacion?.classList.remove("active");
          tabBtnBienvenida?.classList.remove("active");
          tabBtnInicioCurso?.classList.add("active");
          if (tabPaneParticipacion) tabPaneParticipacion.style.display = "none";
          if (tabPaneBienvenida) tabPaneBienvenida.style.display = "none";
          if (tabPaneInicioCurso) tabPaneInicioCurso.style.display = "flex";
          if (flyerParticipacionCard)
            flyerParticipacionCard.style.display = "none";
          if (flyerDocenteContainer)
            flyerDocenteContainer.style.display = "none";
          if (flyerInicioCursoContainer)
            flyerInicioCursoContainer.style.display = "block";
          if (btnDownloadLabel) {
            const formatName =
              currentInicioFormat === "9:16"
                ? "Historia 9:16 (1080×1920)"
                : currentInicioFormat === "4:5"
                  ? "Vertical 4:5 (1080×1350)"
                  : "Cuadrado 1:1 (1080×1080)";
            btnDownloadLabel.textContent = `Descargar Post ${formatName} (HD)`;
          }
        }

        autoFitToScreen();
      }

      tabBtnParticipacion?.addEventListener("click", () =>
        switchTab("participacion"),
      );
      tabBtnBienvenida?.addEventListener("click", () =>
        switchTab("bienvenida"),
      );
      tabBtnInicioCurso?.addEventListener("click", () =>
        switchTab("inicio-curso"),
      );

      // ==========================================
      // 3. SINCRONIZACIÓN FLYER DE PARTICIPACIÓN
      // ==========================================
      function updatePartFlyer() {
        const curso = inputPartCurso?.value?.trim() || "";
        const pead = inputPartPead?.value?.trim() || "";
        if (viewPartCursoPead) {
          if (!curso && !pead) {
            viewPartCursoPead.textContent = "";
          } else if (curso && pead) {
            viewPartCursoPead.textContent = `${curso.toUpperCase()} - ${pead.toUpperCase()}`;
          } else {
            viewPartCursoPead.textContent = (curso || pead).toUpperCase();
          }

          const len = viewPartCursoPead.textContent.length;
          if (len > 36) {
            viewPartCursoPead.style.fontSize = "14.5px";
          } else if (len > 28) {
            viewPartCursoPead.style.fontSize = "17px";
          } else if (len > 22) {
            viewPartCursoPead.style.fontSize = "18.5px";
          } else {
            viewPartCursoPead.style.fontSize = "20px";
          }
        }
      }

      inputPartCurso?.addEventListener("input", updatePartFlyer);
      inputPartPead?.addEventListener("input", updatePartFlyer);
      inputPartCurso?.addEventListener("change", updatePartFlyer);
      inputPartPead?.addEventListener("change", updatePartFlyer);

      // Permite también editar directamente en el flyer haciendo clic sobre la píldora
      viewPartCursoPead?.addEventListener("input", () => {
        const text = viewPartCursoPead.textContent?.trim() || "";
        if (text.includes("-")) {
          const parts = text.split("-");
          if (inputPartCurso) inputPartCurso.value = parts[0].trim();
          if (inputPartPead)
            inputPartPead.value = parts.slice(1).join("-").trim();
        } else {
          if (inputPartCurso) inputPartCurso.value = text;
        }
      });

      // Atajos rápidos para Participación
      document.querySelectorAll(".chip-part").forEach((btn) => {
        btn.addEventListener("click", () => {
          const c = btn.getAttribute("data-part-curso");
          const p = btn.getAttribute("data-part-pead");
          if (c && inputPartCurso) inputPartCurso.value = c;
          if (p && inputPartPead) inputPartPead.value = p;
          updatePartFlyer();
        });
      });

      // Toast de Notificación
      function showToast(
        title: string,
        desc: string,
        type: "success" | "warning" | "error" = "success",
      ) {
        const container = document.getElementById("toastContainer");
        if (!container) return;

        const toast = document.createElement("div");
        toast.className = `toast toast-${type}`;

        const iconSvg =
          type === "success"
            ? `<svg class="toast-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>`
            : `<svg class="toast-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`;

        toast.innerHTML = `
        ${iconSvg}
        <div class="toast-content">
          <span class="toast-title">${title}</span>
          <span class="toast-desc">${desc}</span>
        </div>
      `;

        container.appendChild(toast);
        setTimeout(() => toast.classList.add("show"), 20);

        setTimeout(() => {
          toast.classList.remove("show");
          setTimeout(() => toast.remove(), 350);
        }, 4500);
      }

      // ==========================================
      // 4. SINCRONIZACIÓN FLYER DE BIENVENIDA
      // ==========================================
      function updateFlyer() {
        const curso = inputCurso?.value?.trim() || "AutoCAD 2D";
        const tipoCurso = inputTipoCurso?.value?.trim() || "regular";
        const pead = inputPead?.value?.trim() || "a";
        const semanas = inputSemanas?.value?.trim() || "4 semanas";
        const ciclo = inputCiclo?.value?.trim() || "(2026-II)";
        const docenteNombre =
          inputDocenteNombre?.value?.trim() || "Mgtr. Juan Pérez Gómez";

        // 1. Título, Badge y Tipo de Curso
        if (viewCursoTitulo)
          viewCursoTitulo.textContent = curso.endsWith("!")
            ? curso
            : curso + "!";
        if (viewPeadBadge) viewPeadBadge.textContent = "PEAD - " + pead;
        if (viewTipoCurso) viewTipoCurso.textContent = tipoCurso;
        if (viewSemanasText) viewSemanasText.textContent = semanas;

        // 2. Nombre del docente en la cinta (Adaptable con salto a 2da línea si es largo)
        if (viewDocenteNombre) {
          viewDocenteNombre.textContent = docenteNombre;
          const len = docenteNombre.length;
          const ribbon = viewDocenteNombre.closest(
            ".teacher-badge-ribbon",
          ) as HTMLElement | null;

          if (len > 34) {
            viewDocenteNombre.style.fontSize = "8.8px";
            viewDocenteNombre.style.lineHeight = "1.14";
            if (ribbon) ribbon.style.borderRadius = "9px";
          } else if (len > 22) {
            viewDocenteNombre.style.fontSize = "9.8px";
