      btnTriggerUploadInicio?.addEventListener("click", () =>
        inicioPhotoInput?.click(),
      );
      inicioPhotoInput?.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement | null;
        if (target?.files && target.files.length > 0)
          handleInicioPhotoFile(target.files[0]);
      });

      btnResetInicioPhoto?.addEventListener("click", () => {
        currentInicioPhotoSrc = defaultInicioPhotoUrl;
        if (viewInicioPhotoImg) viewInicioPhotoImg.src = defaultInicioPhotoUrl;
        if (sidebarInicioPhotoThumb)
          sidebarInicioPhotoThumb.src = defaultInicioPhotoUrl;
        if (sliderInicioZoom) sliderInicioZoom.value = "100";
        if (sliderInicioPosY) sliderInicioPosY.value = "0";
        if (sliderInicioPosX) sliderInicioPosX.value = "0";
        updateInicioPhotoTransform();
      });

      function setInicioFormat(format: "1:1" | "4:5" | "9:16") {
        currentInicioFormat = format;

        // Botones de selector de formato
        btnFormatSquare?.classList.toggle("active", format === "1:1");
        btnFormatPortrait?.classList.toggle("active", format === "4:5");
        btnFormatStory?.classList.toggle("active", format === "9:16");

        // Clases de diseño de la plantilla
        flyerInicioCursoCard?.classList.remove(
          "format-square",
          "format-portrait",
          "format-story",
        );
        if (format === "1:1") {
          flyerInicioCursoCard?.classList.add("format-square");
        } else if (format === "4:5") {
          flyerInicioCursoCard?.classList.add("format-portrait");
        } else if (format === "9:16") {
          flyerInicioCursoCard?.classList.add("format-story");
        }

        // Etiqueta del botón de descarga
        if (btnDownloadLabel && currentTab === "inicio-curso") {
          const formatName =
            format === "9:16"
              ? "Historia 9:16 (1080×1920)"
              : format === "4:5"
                ? "Vertical 4:5 (1080×1350)"
                : "Cuadrado 1:1 (1080×1080)";
          btnDownloadLabel.textContent = `Descargar Post ${formatName} (HD)`;
        }

        updateInicioFlyer();
        autoFitToScreen();
      }

      btnFormatSquare?.addEventListener("click", () => setInicioFormat("1:1"));
      btnFormatPortrait?.addEventListener("click", () =>
        setInicioFormat("4:5"),
      );
      btnFormatStory?.addEventListener("click", () =>
        setInicioFormat("9:16"),
      );

      // Listeners reactivos para Tab 3
      [
        inputInicioDocenteNombre,
        checkShowInicioTeacher,
        inputInicioCurso,
        inputInicioPead,
        inputInicioCiclo,
        inputInicioModalidad,
        inputInicioTurno,
        inputInicioFecha,
        inputInicioMensaje,
      ].forEach((el) => {
        el?.addEventListener("input", updateInicioFlyer);
        el?.addEventListener("change", updateInicioFlyer);
      });

      document.querySelectorAll("[data-preset-inicio]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const key = btn.getAttribute("data-preset-inicio");
          if (key === "autocad") {
            if (inputInicioCurso) inputInicioCurso.value = "AutoCAD 2D";
            if (inputInicioPead) inputInicioPead.value = "a";
            if (inputInicioTurno) inputInicioTurno.value = "TARDE";
          } else if (key === "excel") {
            if (inputInicioCurso) inputInicioCurso.value = "Excel Financiero";
            if (inputInicioPead) inputInicioPead.value = "b";
            if (inputInicioTurno) inputInicioTurno.value = "NOCHE";
          } else if (key === "powerbi") {
            if (inputInicioCurso) inputInicioCurso.value = "Power BI";
            if (inputInicioPead) inputInicioPead.value = "a";
            if (inputInicioTurno) inputInicioTurno.value = "MAÑANA";
          }
          updateInicioFlyer();
        });
      });

      // ========================================================
      // AUTO-AJUSTE DINÁMICO A LA PANTALLA (CERO SCROLL EN ESCRITORIO,
      // ESCALADO PERFECTO Y FLUIDO EN MÓVILES)
      // ========================================================
      function autoFitToScreen() {
        if (!previewViewport || !bannerWrapper) return;
        let activeCard: HTMLElement | null = null;
        if (currentTab === "participacion") {
          activeCard = document.getElementById("flyerParticipacionCard");
        } else if (currentTab === "bienvenida") {
          activeCard = document.getElementById("flyerCard");
        } else {
          activeCard = document.getElementById("flyerInicioCursoCard");
        }
        if (!activeCard) return;

        const isMobile = window.innerWidth <= 950;
        const cardW =
          activeCard.offsetWidth ||
          (currentTab === "participacion"
            ? 896
            : currentTab === "bienvenida"
              ? 680
              : 1080);
        const cardH =
          activeCard.offsetHeight ||
          (currentTab === "participacion"
            ? 1200
            : currentTab === "bienvenida"
              ? 880
              : currentInicioFormat === "9:16"
                ? 1920
                : currentInicioFormat === "4:5"
                  ? 1350
                  : 1080);

        if (isMobile) {
          // En móviles, el factor restrictivo es el ancho de pantalla
          const padX = 22;
          const containerWidth =
            previewViewport.clientWidth || window.innerWidth;
          const availW = Math.max(260, containerWidth - padX);
          const scaleX = availW / cardW;

          currentScale = Math.max(0.2, Math.min(scaleX, 1.15));
          bannerWrapper.style.transformOrigin = "top center";
          bannerWrapper.style.transform = `scale(${currentScale})`;

          const scaledW = Math.round(cardW * currentScale);
          const scaledH = Math.round(cardH * currentScale);
          const wrapperOuter = document.getElementById("bannerWrapperOuter");
          if (wrapperOuter) {
            wrapperOuter.style.width = `${scaledW}px`;
            wrapperOuter.style.height = `${scaledH + 16}px`;
          }
        } else {
          // En escritorio, encaje exacto a 100vh sin scroll
          const padX = 28;
          const padY = 28;
          const availW = previewViewport.clientWidth - padX;
          const availH = previewViewport.clientHeight - padY;

          const scaleX = availW / cardW;
          const scaleY = availH / cardH;
          currentScale = Math.min(scaleX, scaleY);
          currentScale = Math.max(0.35, Math.min(currentScale, 1.25));

          bannerWrapper.style.transformOrigin = "center center";
          bannerWrapper.style.transform = `scale(${currentScale})`;

          const wrapperOuter = document.getElementById("bannerWrapperOuter");
          if (wrapperOuter) {
            wrapperOuter.style.width = "";
            wrapperOuter.style.height = "";
          }
        }

        if (zoomPercentText)
          zoomPercentText.textContent = Math.round(currentScale * 100) + "%";
      }

      function manualZoom(delta: number) {
        if (!bannerWrapper) return;
        const isMobile = window.innerWidth <= 950;
        currentScale = Math.max(0.2, Math.min(currentScale + delta, 1.6));
        bannerWrapper.style.transform = `scale(${currentScale})`;

        if (isMobile) {
          let activeCard: HTMLElement | null = null;
          if (currentTab === "participacion") {
            activeCard = document.getElementById("flyerParticipacionCard");
          } else if (currentTab === "bienvenida") {
            activeCard = document.getElementById("flyerCard");
          } else {
            activeCard = document.getElementById("flyerInicioCursoCard");
          }
          const cardW =
            activeCard?.offsetWidth ||
            (currentTab === "participacion"
              ? 896
              : currentTab === "bienvenida"
                ? 680
                : 1080);
          const cardH =
            activeCard?.offsetHeight ||
            (currentTab === "participacion"
              ? 1200
              : currentTab === "bienvenida"
                ? 880
                : currentInicioFormat === "9:16"
                  ? 1920
                  : currentInicioFormat === "4:5"
                    ? 1350
                    : 1080);
          const wrapperOuter = document.getElementById("bannerWrapperOuter");
          if (wrapperOuter) {
            wrapperOuter.style.width = `${Math.round(cardW * currentScale)}px`;
            wrapperOuter.style.height = `${Math.round(cardH * currentScale + 16)}px`;
          }
        }

        if (zoomPercentText)
          zoomPercentText.textContent = Math.round(currentScale * 100) + "%";
      }

      document
        .getElementById("btnZoomIn")
        ?.addEventListener("click", () => manualZoom(0.08));
      document
        .getElementById("btnZoomOut")
        ?.addEventListener("click", () => manualZoom(-0.08));
      document
        .getElementById("btnZoomFit")
        ?.addEventListener("click", autoFitToScreen);

      window.addEventListener("resize", autoFitToScreen);
      window.addEventListener("orientationchange", () =>
        setTimeout(autoFitToScreen, 150),
      );

      // ========================================================
      // NAVEGACIÓN Y SALTOS FLUIDOS EN MÓVILES (FORMULARIO ↔ FLYER)
      // ========================================================
      const btnMobileJumpToPreview = document.getElementById(
        "btnMobileJumpToPreview",
      );
      const btnMobileJumpToEditor = document.getElementById(
        "btnMobileJumpToEditor",
      );
      const btnFloatPill = document.getElementById("btnFloatPill");
      const pillIconEye = document.getElementById("pillIconEye");
      const pillIconEdit = document.getElementById("pillIconEdit");
      const pillText = document.getElementById("pillText");

      function scrollToPreview() {
        if (previewViewport) {
          previewViewport.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
        }
      }

      function scrollToEditor() {
        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      btnMobileJumpToPreview?.addEventListener("click", scrollToPreview);
      btnMobileJumpToEditor?.addEventListener("click", scrollToEditor);

      let isPreviewInView = false;
      function updateMobilePillState() {
        if (!previewViewport) return;
        const rect = previewViewport.getBoundingClientRect();
        // Cuando el visor del flyer está en pantalla
        const inView = rect.top < window.innerHeight * 0.55;
        if (inView !== isPreviewInView) {
          isPreviewInView = inView;
          if (isPreviewInView) {
            if (pillIconEye) pillIconEye.style.display = "none";
            if (pillIconEdit) pillIconEdit.style.display = "inline-block";
            if (pillText) pillText.textContent = "Editar";
          } else {
            if (pillIconEye) pillIconEye.style.display = "inline-block";
            if (pillIconEdit) pillIconEdit.style.display = "none";
            if (pillText) pillText.textContent = "Ver Flyer";
          }
        }
      }

      window.addEventListener("scroll", updateMobilePillState, {
        passive: true,
      });

      btnFloatPill?.addEventListener("click", () => {
        if (isPreviewInView) {
          scrollToEditor();
        } else {
          scrollToPreview();
        }
      });

      // ========================================================
      // EXPORTACIÓN EN ALTA RESOLUCIÓN PNG Y REGISTRO EN SUPABASE
      // ========================================================
      async function downloadFlyerPNG() {
        const overlay = document.getElementById("exportOverlay");
        const statusText = document.getElementById("exportStatusText");

        // ----------------------------------------------------
        // CASO 1: FLYER DE PARTICIPACIÓN EN CLASES
        // ----------------------------------------------------
        if (currentTab === "participacion") {
          const curso = inputPartCurso?.value?.trim() || "DISEÑO WEB";
          const pead = inputPartPead?.value?.trim() || "PEAD B";
          const card = document.getElementById("flyerParticipacionCard");
          if (!card) return;

          if (overlay) overlay.style.display = "flex";
          if (statusText)
            statusText.textContent =
              "Renderizando flyer de Participación en Alta Definición (HD)...";

          await new Promise((r) => setTimeout(r, 150));

          try {
            if (document.fonts) await document.fonts.ready;

            const prevTransform = bannerWrapper
              ? bannerWrapper.style.transform
              : "";
            if (bannerWrapper) bannerWrapper.style.transform = "none";

            let imgData = "";
            try {
              imgData = await htmlToImage.toPng(card, {
                pixelRatio: 2.5,
                backgroundColor: "#ffffff",
                cacheBust: true,
                style: {
                  transform: "none",
                  margin: "0",
                },
              });
            } catch (engineErr) {
              console.warn(
                "[html-to-image fallback a html2canvas]:",
                engineErr,
              );
              const canvas = await html2canvas(card, {
                scale: 2.5,
                useCORS: true,
                allowTaint: true,
                backgroundColor: "#ffffff",
                logging: false,
              });
              imgData = canvas.toDataURL("image/png", 1.0);
            } finally {
              if (bannerWrapper) bannerWrapper.style.transform = prevTransform;
            }

            if (statusText)
              statusText.textContent = "Descargando imagen PNG oficial...";
            const link = document.createElement("a");
            const cursoSanitized = curso.replace(/[^a-zA-Z0-9_-]/g, "_");
            const peadSanitized = pead.replace(/[^a-zA-Z0-9_-]/g, "_");
            link.download = `Flyer_Participacion_USS_${cursoSanitized}_${peadSanitized}.png`;
            link.href = imgData;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            // Registro en Supabase
            try {
              await registrarGeneracionFlyer({
                nombreDocente: "PARTICIPACIÓN EN CLASES",
                curso: curso,
                pead: pead,
                ciclo: pead,
                turno: "VIRTUAL",
                modalidad: "Virtual",
                horarioDias: "OFICIAL",
                horarioHoras: "OFICIAL",
                fechaInicio: "INICIO DE CLASES",
              });
            } catch (dbErr) {
              console.warn("Registro en BD omitido:", dbErr);
            }

            if (statusText) statusText.textContent = "¡Completado!";
            setTimeout(() => {
              if (overlay) overlay.style.display = "none";
            }, 400);

            showToast(
              "¡Flyer generado con éxito!",
              `Flyer de Participación para "${curso} - ${pead}" descargado en HD.`,
              "success",
            );
          } catch (err) {
            console.error("Error al exportar:", err);
            alert("Error al generar la imagen: " + (err?.message || err));
            if (overlay) overlay.style.display = "none";
          }
          return;
        }

        // ----------------------------------------------------
        // CASO 3: POST DE INICIO DE CLASES CON ESTUDIANTES (FB / IG / HISTORIA)
        // ----------------------------------------------------
        if (currentTab === "inicio-curso") {
          const curso = inputInicioCurso?.value?.trim() || "AutoCAD 2D";
          const pead = inputInicioPead?.value?.trim() || "a";
          const formatStr =
            currentInicioFormat === "9:16"
              ? "9x16_Story_1080x1920"
              : currentInicioFormat === "4:5"
                ? "4x5_Vertical_1080x1350"
                : "1x1_Cuadrado_1080x1080";
          const card = document.getElementById("flyerInicioCursoCard");
          if (!card) return;

          if (overlay) overlay.style.display = "flex";
          if (statusText)
            statusText.textContent =
              `Renderizando Post ${currentInicioFormat} en Alta Definición Oficial...`;

          await new Promise((r) => setTimeout(r, 150));

          try {
            if (document.fonts) await document.fonts.ready;

            const prevTransform = bannerWrapper
              ? bannerWrapper.style.transform
              : "";
            if (bannerWrapper) bannerWrapper.style.transform = "none";

            let imgData = "";
            try {
              imgData = await htmlToImage.toPng(card, {
                pixelRatio: 2.0,
                backgroundColor: "#ffffff",
                cacheBust: true,
                style: {
                  transform: "none",
                  margin: "0",
                },
              });
            } catch (engineErr) {
              console.warn(
                "[html-to-image fallback a html2canvas]:",
                engineErr,
              );
              const canvas = await html2canvas(card, {
                scale: 2.0,
                useCORS: true,
                allowTaint: true,
                backgroundColor: "#ffffff",
                logging: false,
              });
              imgData = canvas.toDataURL("image/png", 1.0);
            } finally {
              if (bannerWrapper) bannerWrapper.style.transform = prevTransform;
            }

            if (statusText)
              statusText.textContent = "Descargando imagen PNG oficial...";
            const link = document.createElement("a");
            const cursoSanitized = curso.replace(/[^a-zA-Z0-9_-]/g, "_");
            const peadSanitized = pead.replace(/[^a-zA-Z0-9_-]/g, "_");
            link.download = `Post_Inicio_Clases_USS_${cursoSanitized}_PEAD_${peadSanitized}_${formatStr}.png`;
            link.href = imgData;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            // Registro en Supabase
            try {
              await registrarGeneracionFlyer({
                nombreDocente:
                  inputInicioDocenteNombre?.value?.trim() ||
                  "Docente CINF",
                curso: curso,
                pead: pead,
                ciclo: inputInicioCiclo?.value?.trim() || "(2026-II)",
                turno: inputInicioTurno?.value?.trim() || "TARDE",
                modalidad: inputInicioModalidad?.value?.trim() || "Virtual",
                fechaInicio: inputInicioFecha?.value?.trim() || "",
              });
            } catch (dbErr) {
              console.warn("Registro en BD omitido:", dbErr);
            }

            if (statusText) statusText.textContent = "¡Completado!";
            setTimeout(() => {
              if (overlay) overlay.style.display = "none";
            }, 400);

            showToast(
              "¡Post de Inicio de Clases generado!",
              `Descargado con éxito para redes sociales en formato ${formatStr}.`,
              "success",
            );
          } catch (err) {
            console.error("Error al exportar:", err);
            alert("Error al generar la imagen: " + (err?.message || err));
            if (overlay) overlay.style.display = "none";
          }
          return;
        }

        // ----------------------------------------------------
        // CASO 2: FLYER ORIGINAL DE BIENVENIDA DOCENTE
        // ----------------------------------------------------
        const docenteNombre = inputDocenteNombre?.value?.trim() || "";
        if (!docenteNombre) {
          alert(
            "Por favor ingrese el nombre del docente antes de generar el flyer.",
          );
          inputDocenteNombre?.focus();
          return;
        }

        if (overlay) overlay.style.display = "flex";
        if (statusText)
          statusText.textContent =
            "Renderizando flyer en Alta Definición (HD)...";

        await new Promise((r) => setTimeout(r, 150));

        const card = document.getElementById("flyerCard");
        if (!card) return;

        try {
          // Esperar fuentes web
          if (document.fonts) {
            await document.fonts.ready;
          }

          // Desactivar temporalmente la escala del visor para capturar a resolución 100% nativa
          const prevTransform = bannerWrapper
            ? bannerWrapper.style.transform
            : "";
          if (bannerWrapper) bannerWrapper.style.transform = "none";

          let imgData = "";
          try {
            imgData = await htmlToImage.toPng(card, {
              pixelRatio: 2.5,
              backgroundColor: "#ffffff",
              cacheBust: true,
              style: {
                transform: "none",
                margin: "0",
              },
            });
          } catch (engineErr) {
            console.warn("[html-to-image fallback a html2canvas]:", engineErr);
            const canvas = await html2canvas(card, {
              scale: 2.5,
              useCORS: true,
              allowTaint: true,
              backgroundColor: "#ffffff",
              logging: false,
            });
            imgData = canvas.toDataURL("image/png", 1.0);
          } finally {
            if (bannerWrapper) bannerWrapper.style.transform = prevTransform;
          }

          if (statusText)
            statusText.textContent =
              "Descargando imagen PNG y registrando en base de datos...";
          const link = document.createElement("a");
          const cursoSanitized = (inputCurso?.value?.trim() || "Curso").replace(
            /[^a-zA-Z0-9_-]/g,
            "_",
          );
          const peadSanitized = (inputPead?.value?.trim() || "a").replace(
            /[^a-zA-Z0-9_-]/g,
            "_",
          );
          const docenteSanitized = docenteNombre.replace(
            /[^a-zA-Z0-9_-]/g,
            "_",
          );
          link.download = `Flyer_USS_${cursoSanitized}_${docenteSanitized}_PEAD_${peadSanitized}.png`;
          link.href = imgData;
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);

          // 3. Registro en Supabase
          const supabaseResult = await registrarGeneracionFlyer({
            nombreDocente: docenteNombre,
            curso: inputCurso?.value?.trim() || "",
            pead: inputPead?.value?.trim() || "",
            ciclo: inputCiclo?.value?.trim() || "",
            turno: inputTurno?.value?.trim() || "",
            modalidad: inputModalidad?.value?.trim() || "",
            horarioDias: inputDias?.value?.trim() || "",
            horarioHoras: inputHoras?.value?.trim() || "",
            fechaInicio: inputFechaInicio?.value?.trim() || "",
          });

          if (statusText) statusText.textContent = "¡Completado!";
          setTimeout(() => {
            if (overlay) overlay.style.display = "none";
          }, 400);

          if (supabaseResult.success) {
            showToast(
              "¡Flyer generado y registrado!",
              `Docente "${docenteNombre}" guardado con éxito en la base de datos de Supabase.`,
              "success",
            );
          } else {
            showToast(
              "Flyer PNG descargado",
              `Aviso BD: ${supabaseResult.error || "Recuerda crear la tabla tbl_docentes_flyers en Supabase."}`,
              "warning",
            );
          }
        } catch (err) {
          console.error("Error al exportar:", err);
          alert("Error al generar la imagen: " + (err?.message || err));
          if (overlay) overlay.style.display = "none";
        }
      }

      document
        .getElementById("btnDownloadAction")
        ?.addEventListener("click", downloadFlyerPNG);

      // ==========================================
      // GESTIÓN DE TEMA CLARO / OSCURO (BLANCO POR DEFECTO)
      // ==========================================
      function getInitialTheme() {
        const saved = localStorage.getItem("uss_theme");
        return saved === "dark" ? "dark" : "light";
      }

      function updateThemeUI(theme: string) {
        document.documentElement.setAttribute("data-theme", theme);
        const themeToggleText = document.getElementById("themeToggleText");
        const themeToggleBtn = document.getElementById("themeToggleBtn");
        const btnThemeToggleFloat = document.getElementById("btnThemeToggleFloat");

        if (theme === "dark") {
          if (themeToggleText) themeToggleText.textContent = "Modo Claro";
          if (themeToggleBtn) {
            themeToggleBtn.setAttribute("title", "Cambiar a Modo Claro (Blanco)");
            themeToggleBtn.setAttribute("aria-label", "Cambiar a Modo Claro (Blanco)");
          }
          if (btnThemeToggleFloat) {
            btnThemeToggleFloat.setAttribute("title", "Cambiar a Modo Claro (Blanco)");
            btnThemeToggleFloat.setAttribute("aria-label", "Cambiar a Modo Claro (Blanco)");
          }
        } else {
          if (themeToggleText) themeToggleText.textContent = "Modo Oscuro";
          if (themeToggleBtn) {
            themeToggleBtn.setAttribute("title", "Cambiar a Modo Oscuro");
            themeToggleBtn.setAttribute("aria-label", "Cambiar a Modo Oscuro");
          }
          if (btnThemeToggleFloat) {
            btnThemeToggleFloat.setAttribute("title", "Cambiar a Modo Oscuro");
            btnThemeToggleFloat.setAttribute("aria-label", "Cambiar a Modo Oscuro");
          }
        }
      }

      function toggleTheme() {
        const currentTheme = document.documentElement.getAttribute("data-theme") || "light";
        const newTheme = currentTheme === "dark" ? "light" : "dark";
        localStorage.setItem("uss_theme", newTheme);
        updateThemeUI(newTheme);
      }

      document.getElementById("themeToggleBtn")?.addEventListener("click", toggleTheme);
      document.getElementById("btnThemeToggleFloat")?.addEventListener("click", toggleTheme);

      // Inicialización al cargar la página
      window.addEventListener("DOMContentLoaded", () => {
        updateThemeUI(getInitialTheme());
        updatePartFlyer();
        updateFlyer();
        updatePhotoTransform();
        updateInicioFlyer();
        updateInicioPhotoTransform();
        autoFitToScreen();
        setTimeout(autoFitToScreen, 150);
      });
    </script>
  </body>
</html>
