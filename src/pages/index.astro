      function updateInicioPhotoTransform() {
        if (sliderInicioZoom) {
          currentInicioZoom = parseInt(sliderInicioZoom.value, 10);
          if (zoomInicioVal) zoomInicioVal.textContent = currentInicioZoom + "%";
        }
        if (sliderInicioPosY) {
          currentInicioPosY = parseInt(sliderInicioPosY.value, 10);
          if (posInicioYVal) posInicioYVal.textContent = currentInicioPosY + "%";
        }
        if (sliderInicioPosX) {
          currentInicioPosX = parseInt(sliderInicioPosX.value, 10);
          if (posInicioXVal) posInicioXVal.textContent = currentInicioPosX + "%";
        }
        if (viewInicioPhotoImg) {
          viewInicioPhotoImg.style.transform = `scale(${currentInicioZoom / 100}) translate(${currentInicioPosX}%, ${currentInicioPosY}%)`;
        }
      }

      sliderInicioZoom?.addEventListener("input", updateInicioPhotoTransform);
      sliderInicioPosY?.addEventListener("input", updateInicioPhotoTransform);
      sliderInicioPosX?.addEventListener("input", updateInicioPhotoTransform);

      function handleInicioPhotoFile(file: File) {
        if (!file || !file.type.startsWith("image/")) {
          showToast(
            "Formato no válido",
            "Por favor sube una imagen PNG, JPG o WebP.",
