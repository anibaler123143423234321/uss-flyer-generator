---
// src/components/FlyerParticipacionCard.astro
---
<div id="flyerParticipacionCard" class="flyer-card-participacion">

  <!-- Decoración geométrica superior verde institucional USS -->
  <div class="part-top-bg-accent">
    <svg viewBox="0 0 680 90" preserveAspectRatio="none" class="part-top-svg">
      <path d="M0,0 L680,0 L680,45 Q510,75 340,55 Q170,35 0,65 Z" fill="#f0fdf4" opacity="0.6"/>
      <path d="M480,0 L680,0 L680,50 L560,0 Z" fill="#004e35" opacity="0.08"/>
      <circle cx="640" cy="20" r="45" fill="#11acd3" opacity="0.06"/>
    </svg>
  </div>

  <!-- 1. Cabecera Oficial Limpia (Sin eslogan tachado arriba ni a la derecha) -->
  <div class="part-header">
    <div class="part-logo-wrap">
      <img class="part-logo-img" id="partLogoImg" src="/logo-uss.png" alt="Centro de Informática USS" />
    </div>
    <!-- Espacio superior derecho intencionalmente limpio (se omitió texto tachado en celeste) -->
    <div class="part-header-right">
      <div class="part-badge-tag">COMUNICADO OFICIAL</div>
    </div>
  </div>

  <!-- 2. Banner Principal: Título + Megáfono -->
  <div class="part-hero-section">
    <div class="part-hero-banner">
      <!-- Megáfono Vectorial en Verde USS -->
      <div class="part-megaphone-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 11l19-9-9 19-2-8-8-2z" fill="#004e35" stroke="#004e35"/>
          <path d="M11 13l4-4" stroke="#ffffff" stroke-width="2"/>
        </svg>
      </div>

      <div class="part-hero-text-wrap">
        <div class="part-lead-pill">
          <span>IMPORTANCIA DE LA</span>
        </div>
        <h1 class="part-main-title">
          PARTICIPACIÓN EN CLASES
        </h1>
      </div>
    </div>

    <!-- Píldora Central Dinámica: NOMBRE DEL CURSO Y PEAD (Modificable en Sidebar) -->
    <div class="part-course-pill-container">
      <div class="part-course-pead-pill" id="viewPartCursoPead">
        COMPUTACIÓN I - PEAD 2026-I
      </div>
    </div>
  </div>

  <!-- 3. Sección Central: Mensaje al Estudiante + Gráfico Laptop Zoom -->
  <div class="part-content-grid">
    <!-- Columna Izquierda: Mensaje Formal -->
    <div class="part-message-col">
      <h2 class="part-greeting-heading">Estimado(a) Estudiante:</h2>
      <p class="part-message-body">
        El presente mensaje tiene como finalidad recordarles <strong class="part-highlight-bold">la importancia de la participación activa y continua en todas las clases del curso</strong>, ya que esta forma parte fundamental del proceso de aprendizaje y de su evaluación académica.
      </p>
    </div>

    <!-- Columna Derecha: Ilustración Laptop Zoom + Bloc de Notas -->
    <div class="part-graphic-col">
      <!-- Lema Manuscrito Flotante -->
      <div class="part-handwriting-quote">
        <span>¡Tu participación hace la diferencia!</span>
        <svg class="part-quote-sparkles" viewBox="0 0 28 20" fill="none">
          <path d="M4 14 L2 18" stroke="#004e35" stroke-width="2" stroke-linecap="round"/>
          <path d="M14 10 L14 18" stroke="#004e35" stroke-width="2" stroke-linecap="round"/>
          <path d="M24 14 L26 18" stroke="#004e35" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>

      <!-- Tarjeta Visual de Laptop con Clase Virtual Zoom -->
      <div class="part-laptop-card">
        <div class="part-laptop-screen">
          <!-- Barra superior de Zoom -->
          <div class="part-zoom-topbar">
            <span class="part-zoom-brand">USS Aula Virtual</span>
            <span class="part-zoom-live">● EN VIVO</span>
          </div>

          <!-- Malla de participantes de la clase -->
          <div class="part-zoom-grid">
            <div class="part-zoom-tile active-speaker">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
              <span class="tile-label">Docente</span>
            </div>
            <div class="part-zoom-tile">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
              <span class="tile-label">Estudiante 1</span>
            </div>
            <div class="part-zoom-tile">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
              <span class="tile-label">Estudiante 2</span>
            </div>
            <div class="part-zoom-tile">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
              <span class="tile-label">Estudiante 3</span>
            </div>
          </div>

          <!-- Barra inferior de controles Zoom -->
          <div class="part-zoom-controls">
            <span class="control-btn mic">🎙️</span>
            <span class="control-btn cam">📹</span>
            <span class="control-btn share">⬆️ Compartir</span>
            <span class="control-btn chat">💬</span>
            <span class="control-btn leave">Salir</span>
          </div>
        </div>
        <div class="part-laptop-base"></div>

        <!-- Libreta con Notas (Superpuesta en esquina inferior) -->
        <div class="part-notepad-badge">
          <div class="notepad-spiral">
            <span></span><span></span><span></span><span></span><span></span>
          </div>
          <div class="notepad-lines">
            <div class="note-item"><span class="check">✓</span> <strong>Aprendo</strong></div>
            <div class="note-item"><span class="check">✓</span> <strong>Participo</strong></div>
            <div class="note-item"><span class="check">✓</span> <strong>Logro mis metas</strong></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. Tarjeta de Advertencia / Acuerdo de Directorio (Rosado Suave Oficial) -->
  <div class="part-card-alert">
    <!-- Icono Circular Rojo Documento -->
    <div class="part-alert-icon-circle">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="16" y1="13" x2="8" y2="13"/>
        <line x1="16" y1="17" x2="8" y2="17"/>
        <polyline points="10 9 9 9 8 9"/>
      </svg>
    </div>

    <!-- Contenido Legal Oficial -->
    <div class="part-alert-text-body">
      <p class="part-alert-intro">
        Asimismo, tenga en cuenta que, conforme al
      </p>
      <div class="part-alert-oficio">
        ACUERDO DE DIRECTORIO – OFICIO N.° 0453-2013-SG-USS,
      </div>
      <div class="part-alert-highlight-pill">
        no existe opción de reserva ni retiro del curso una vez realizada la matrícula,
      </div>
      <p class="part-alert-salvo">
        salvo por motivos de salud debidamente justificados.
      </p>
    </div>

    <!-- Icono de Peligro / Alerta Destacado a la Derecha -->
    <div class="part-alert-triangle-wrap">
      <div class="part-alert-rays-left">
        <span></span><span></span>
      </div>
      <svg class="part-alert-triangle" viewBox="0 0 24 24" fill="#dc2626">
        <path d="M12 2L1 21h22L12 2zm0 3.99L19.53 19H4.47L12 5.99zM11 10h2v4h-2zm0 6h2v2h-2z"/>
      </svg>
      <div class="part-alert-rays-right">
        <span></span><span></span>
      </div>
    </div>
  </div>

  <!-- 5. Tarjeta de Compromiso y Disciplina (Menta Suave) -->
  <div class="part-card-commitment">
    <!-- Icono Calendario en Círculo Verde Oscuro -->
    <div class="part-commitment-icon-circle">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
    </div>

    <div class="part-commitment-left-text">
      <strong class="text-bold-green">Los animamos a organizar su tiempo y a mantenerse comprometidos</strong> con el desarrollo del curso.
    </div>

    <div class="part-commitment-divider"></div>

    <div class="part-commitment-right-text">
      <span class="discipline-motto">Disciplina hoy, mejores oportunidades mañana</span>
      <svg class="discipline-underline-svg" viewBox="0 0 180 8" fill="none">
        <path d="M 2 4 Q 90 8 178 3" stroke="#004e35" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
    </div>
  </div>

  <!-- 6. Fila de los 4 Pilares de Éxito -->
  <div class="part-pillars-bar">
    <!-- 1. Participa -->
    <div class="part-pillar-item">
      <div class="pillar-circle-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <circle cx="12" cy="12" r="6"/>
          <circle cx="12" cy="12" r="2"/>
        </svg>
      </div>
      <span class="pillar-label">PARTICIPA</span>
    </div>

    <div class="part-pillar-sep"></div>

    <!-- 2. Aprende -->
    <div class="part-pillar-item">
      <div class="pillar-circle-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
        </svg>
      </div>
      <span class="pillar-label">APRENDE</span>
    </div>

    <div class="part-pillar-sep"></div>

    <!-- 3. Progresa -->
    <div class="part-pillar-item">
      <div class="pillar-circle-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="20" x2="18" y2="10"/>
          <line x1="12" y1="20" x2="12" y2="4"/>
          <line x1="6" y1="20" x2="6" y2="14"/>
        </svg>
      </div>
      <span class="pillar-label">PROGRESA</span>
    </div>

    <div class="part-pillar-sep"></div>

    <!-- 4. Alcanza tus Objetivos -->
    <div class="part-pillar-item">
      <div class="pillar-circle-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
          <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
          <path d="M4 22h16"/>
          <path d="M10 14.66V17c0 .55-.45 1-1 1H7v4h10v-4h-2c-.55 0-1-.45-1-1v-2.34c3.27-.47 5.76-3.23 5.76-6.66H4.24C4.24 11.43 6.73 14.19 10 14.66z"/>
        </svg>
      </div>
      <span class="pillar-label pillar-multiline">ALCANZA<br>TUS OBJETIVOS</span>
    </div>
  </div>

  <!-- 7. Pie Institucional Oficial Verde USS (Sin texto tachado en celeste) -->
  <div class="part-footer">
    <div class="part-footer-brand">
      <span class="part-brand-title">Centro de Informática USS</span>
      <!-- Se omitió deliberadamente "Conocimiento para un mejor futuro" porque fue tachado con X celeste -->
    </div>

    <div class="part-footer-right">
      <div class="part-footer-vdiv"></div>
      <span class="part-footer-slogan">TRANSFORMA TU MUNDO</span>
    </div>
  </div>

</div>
