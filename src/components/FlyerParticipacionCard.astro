---
// src/components/FlyerParticipacionCard.astro
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div id="flyerParticipacionCard" class="flyer-card-participacion-wrapper">
  <!-- Imagen Base Oficial Procesada con Gemini (896x1200) sin logo ni COMUNICADO OFICIAL -->
  <img 
    src={`${base}/flyer-participacion-base.jpg`} 
    alt="Importancia de la Participación en Clases - CINF USS" 
    class="flyer-participacion-bg-img"
    id="flyerParticipacionImg"
    crossorigin="anonymous"
    onerror="if (!this.dataset.fb) { this.dataset.fb = '1'; this.src = this.src.includes('/flyers/') ? this.src.replace('/flyers/', '/') : '/flyers' + new URL(this.src).pathname; }"
  />

  <!-- Overlay Dinámico: Píldora para NOMBRE DEL CURSO Y PEAD -->
  <div class="part-pill-overlay-container" id="partPillContainer" title="Haz clic para editar directamente o usa el panel izquierdo">
    <div 
      class="part-pill-text-overlay" 
      id="viewPartCursoPead"
      contenteditable="true"
      spellcheck="false"
      role="textbox"
      aria-label="Nombre del Curso y PEAD"
    >DISEÑO WEB - PEAD B</div>
  </div>
</div>
