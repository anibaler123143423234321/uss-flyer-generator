---
// src/components/Sidebar.astro
---
<aside class="editor-sidebar">

  <!-- Cabecera Institucional -->
  <div class="sidebar-header">
    <div class="brand-group">
      <div class="brand-badge-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
      </div>
      <div class="brand-title-wrap">
        <h1>Centro de Informática USS</h1>
        <span>Generador de Flyers Oficiales</span>
      </div>
    </div>
    <div class="header-actions">
      <!-- Botón de Modo Oscuro / Claro -->
      <button type="button" class="theme-toggle-btn" id="themeToggleBtn" title="Cambiar a Modo Oscuro" aria-label="Cambiar tema">
        <svg class="icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <span class="theme-btn-label" id="themeToggleText">Modo Oscuro</span>
      </button>

      <div class="supabase-badge" title="Conexión activa con Supabase para registro de docentes">
        <span class="supabase-dot"></span>
        <span>BD Conectada</span>
      </div>
    </div>
  </div>

  <!-- SELECTOR DE PESTAÑAS (TABS) -->
  <div class="tabs-nav-container">
    <button type="button" class="tab-nav-btn active" id="tabBtnParticipacion" data-tab="participacion">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 20h9"/>
        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
      </svg>
      <span>1. Participación (Nuevo)</span>
    </button>
    <button type="button" class="tab-nav-btn" id="tabBtnBienvenida" data-tab="bienvenida">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
      </svg>
      <span>2. Bienvenida Docente</span>
    </button>
  </div>

  <!-- Formulario de Edición con Scroll Interno Suave -->
  <div class="sidebar-scrollable-content">

    <!-- ========================================== -->
    <!-- TAB 1: FORMULARIO PARTICIPACIÓN EN CLASES  -->
    <!-- ========================================== -->
    <div id="tabPaneParticipacion" class="tab-pane active">

      <div class="compact-card">
        <div class="compact-card-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          1. Datos del Flyer
        </div>

        <div class="form-item">
          <label for="inputPartCurso">Curso:</label>
          <input type="text" id="inputPartCurso" class="compact-input" value="DISEÑO WEB" placeholder="Ej: DISEÑO WEB">
        </div>

        <div class="form-item" style="margin-top: 5px;">
          <label for="inputPartPead">PEAD:</label>
          <input type="text" id="inputPartPead" class="compact-input" value="PEAD B" placeholder="Ej: PEAD B">
        </div>

        <div class="chips-row" style="margin-top: 6px;">
          <span class="chips-label">Atajos:</span>
          <button class="chip-mini chip-part" type="button" data-part-curso="DISEÑO WEB" data-part-pead="PEAD B">Diseño Web</button>
          <button class="chip-mini chip-part" type="button" data-part-curso="AUTOCAD 2D" data-part-pead="PEAD A">AutoCAD 2D</button>
          <button class="chip-mini chip-part" type="button" data-part-curso="EXCEL FINANCIERO" data-part-pead="PEAD B">Excel Fin.</button>
          <button class="chip-mini chip-part" type="button" data-part-curso="POWER BI" data-part-pead="PEAD C">Power BI</button>
          <button class="chip-mini chip-part" type="button" data-part-curso="COMPUTACIÓN I" data-part-pead="PEAD A">Computación I</button>
        </div>
      </div>

    </div>

    <!-- ========================================== -->
    <!-- TAB 2: FORMULARIO BIENVENIDA DOCENTE       -->
    <!-- ========================================== -->
    <div id="tabPaneBienvenida" class="tab-pane" style="display: none;">

      <!-- 1. Foto y Nombre del Docente -->
      <div class="compact-card">
        <div class="compact-card-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          1. Docente y Fotografía
        </div>

        <!-- Fila con Foto (Botón adentro) + Sliders y Reset -->
        <div class="photo-uploader-row">
          <!-- Thumbnail con botón de Subir Foto adentro -->
          <div class="photo-avatar-wrap" id="btnTriggerUpload" title="Clic para subir o cambiar foto" role="button" tabindex="0">
            <img id="sidebarPhotoThumb" class="photo-thumb-img" crossorigin="anonymous" src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=600" alt="Foto docente">
            <div class="photo-avatar-btn-overlay">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                <circle cx="12" cy="13" r="4"/>
              </svg>
              <span>Subir Foto</span>
            </div>
          </div>
          <input type="file" id="photoInput" accept="image/*" style="display: none;">

          <!-- Controles laterales compactos: Sliders Zoom y Pos Y + Reset -->
          <div class="photo-controls-col">
            <div class="slider-mini-box">
              <span class="slider-mini-title">Zoom</span>
              <input type="range" id="sliderZoom" min="80" max="230" value="100">
              <span id="zoomVal" class="slider-mini-val">100%</span>
              <button class="btn-reset-icon" id="btnResetPhoto" type="button" title="Restablecer foto de muestra">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                  <path d="M3 3v5h5"/>
                </svg>
              </button>
            </div>
            <div class="slider-mini-box">
              <span class="slider-mini-title">Pos Y</span>
              <input type="range" id="sliderPosY" min="0" max="100" value="0">
              <span id="posVal" class="slider-mini-val">0%</span>
            </div>
          </div>
        </div>

        <!-- Nombre del Docente y Firma -->
        <div class="form-item" style="margin-top: 5px;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2px;">
            <label for="inputDocenteNombre" style="margin-bottom: 0;">Nombre del Docente:</label>
            <label class="checkbox-inline">
              <input type="checkbox" id="checkShowTeacherScript" checked>
              <span>"Tu docente"</span>
            </label>
          </div>
          <input type="text" id="inputDocenteNombre" class="compact-input" value="Mgtr. Juan Pérez Gómez" placeholder="Ej: Mgtr. Juan Pérez Gómez">
        </div>
      </div>

      <!-- 2. Información del Curso -->
      <div class="compact-card">
        <div class="compact-card-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
          </svg>
          2. Datos del Curso
        </div>

        <div class="form-item">
          <label for="inputCurso">Curso:</label>
          <input type="text" id="inputCurso" class="compact-input" value="AutoCAD 2D">
        </div>

        <div class="form-row cols-2" style="margin-top: 5px;">
          <div class="form-item">
            <label for="inputTipoCurso">Tipo:</label>
            <select id="inputTipoCurso" class="compact-input">
              <option value="regular" selected>regular</option>
              <option value="super intensivo">super intensivo</option>
              <option value="intensivo">intensivo</option>
            </select>
          </div>
          <div class="form-item">
            <label for="inputSemanas">Semanas:</label>
            <input type="text" id="inputSemanas" class="compact-input" value="4 semanas">
          </div>
        </div>

        <div class="form-row cols-2" style="margin-top: 5px;">
          <div class="form-item">
            <label for="inputPead">PEAD:</label>
            <input type="text" id="inputPead" class="compact-input" value="a">
          </div>
          <div class="form-item">
            <label for="inputCiclo">Ciclo:</label>
            <input type="text" id="inputCiclo" class="compact-input" value="(2026-II)">
          </div>
        </div>

        <div class="chips-row" style="margin-top: 5px;">
          <span class="chips-label">Atajos:</span>
          <button class="chip-mini" type="button" data-preset="autocad">AutoCAD 2D</button>
          <button class="chip-mini" type="button" data-preset="excel">Excel Financiero</button>
          <button class="chip-mini" type="button" data-preset="powerbi">Power BI</button>
        </div>
      </div>

      <!-- 3. Tabla y Horario -->
      <div class="compact-card">
        <div class="compact-card-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          3. Horario de Clases
        </div>

        <div class="form-row cols-3">
          <div class="form-item">
            <label for="inputModalidad">Modalidad:</label>
            <input type="text" id="inputModalidad" class="compact-input" value="Virtual">
          </div>
          <div class="form-item">
            <label for="inputGrupo">Grupo:</label>
            <input type="text" id="inputGrupo" class="compact-input" value="Pead - a">
          </div>
          <div class="form-item">
            <label for="inputTurno">Turno:</label>
            <input type="text" id="inputTurno" class="compact-input" value="TARDE">
          </div>
        </div>

        <div class="form-row cols-2" style="margin-top: 5px;">
          <div class="form-item">
            <label for="inputDias">Días:</label>
            <input type="text" id="inputDias" class="compact-input" value="MIÉ, JUE, VIE Y SÁB">
          </div>
          <div class="form-item">
            <label for="inputHoras">Horario:</label>
            <input type="text" id="inputHoras" class="compact-input" value="07:00 Pm - 11:00 pm">
          </div>
        </div>

        <div class="form-item" style="margin-top: 5px;">
          <label for="inputFechaInicio">Fecha de Inicio:</label>
          <input type="text" id="inputFechaInicio" class="compact-input" value="miércoles 05 de agosto - 7pm">
        </div>
      </div>

    </div>

  </div>

  <!-- Botón de Descarga Fijo en la parte inferior del Sidebar -->
  <div class="sidebar-footer">
    <button class="btn-download-action" id="btnDownloadAction" type="button">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="7 10 12 15 17 10"/>
        <line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      <span id="btnDownloadLabel">Descargar Flyer en PNG (HD)</span>
    </button>
    <!-- Botón visible exclusivamente en pantallas móviles para saltar de inmediato al diseño -->
    <button class="btn-mobile-jump" id="btnMobileJumpToPreview" type="button">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
        <circle cx="12" cy="12" r="3"/>
      </svg>
      <span>Ver Diseño del Flyer en Vivo ↓</span>
    </button>
  </div>

</aside>
